---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Knyta — Living Field</title>
    <style>
      :root {
        --cream: #f2ede3;
        --plum: #221016;
        --wine: #7a1f3d;
        --red: #e8481f;
        --gold: #f0a24a;
        --ink: #221016;
        --muted: #7a5a54;
        --line: rgba(34,16,22,0.20);
        --serif: "Hoefler Text", "Baskerville", "Iowan Old Style", Palatino, Georgia, serif;
        --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
      }
      * { box-sizing: border-box; margin: 0; }
      html { background: var(--cream); }
      body { background: transparent; color: var(--ink); font-family: var(--serif); font-size: 1.0625rem; line-height: 1.55; -webkit-font-smoothing: antialiased; }
      a { color: inherit; }

      /* Page-wide dithered swarm. Absolute (not fixed) so it's pinned to the
         document and scrolls with the page; its height is set to the full page
         height in JS. The field's low end is the page cream, so it reads as a
         soft warm presence, not a slab. */
      #bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 0;
        display: block;
        image-rendering: pixelated; /* crisp dither dots — the blur is in the field, not here */
        pointer-events: none;
      }

      .frame { position: relative; z-index: 1; min-height: 100vh; padding: clamp(0.9rem, 2.4vw, 1.9rem); }
      .mat {
        border: 1.5px solid var(--red);
        min-height: calc(100vh - clamp(1.8rem, 4.8vw, 3.8rem));
        padding: 0 clamp(1.4rem, 4.5vw, 3.5rem);
        display: flex;
        flex-direction: column;
      }

      header {
        display: flex; justify-content: space-between; align-items: baseline;
        font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--wine);
        padding: 1.6rem 0; border-bottom: 1px solid var(--line);
      }
      header .brand { font-family: var(--serif); font-style: italic; font-size: 1.5rem; letter-spacing: -0.01em; text-transform: none; color: var(--red); line-height: 1; }
      header .rooms { display: flex; gap: 1.6rem; }
      header .rooms a { text-decoration: none; }
      header .rooms a:hover { color: var(--red); }

      .eyebrow { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 2.4rem 0 1.4rem; }
      .eyebrow b { color: var(--red); font-weight: 500; }
      .eyebrow i { font-style: italic; text-transform: none; letter-spacing: 0; }

      .hero { padding: clamp(1.5rem, 5vw, 4rem) 0 clamp(2rem, 6vw, 5rem); }
      h1 {
        font-family: var(--serif); font-weight: 600;
        font-size: clamp(2.8rem, 8.5vw, 6.5rem); line-height: 0.94; letter-spacing: -0.02em;
        max-width: 15ch; color: var(--plum);
      }
      h1 em { font-style: italic; color: var(--red); }
      .lede { font-family: var(--serif); font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.5; max-width: 34rem; margin-top: 1.8rem; color: var(--ink); }
      .lede strong { color: var(--red); font-weight: 600; font-style: italic; }
      .cta { margin-top: 2.2rem; display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; }
      .tickets { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; background: var(--red); color: var(--cream); padding: 0.85rem 1.6rem; border-radius: 2px; }
      .tickets:hover { background: var(--plum); }
      .ghost { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
      .ghost:hover { color: var(--red); }
      .hint { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--muted); margin-top: 1.4rem; opacity: 0.8; }

      section.block { padding: clamp(2.5rem, 6vw, 5rem) 0; border-top: 1px solid var(--line); }
      .sec-no { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); margin-bottom: 1rem; }
      h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(1.8rem, 4vw, 2.9rem); line-height: 1.05; letter-spacing: -0.015em; max-width: 24ch; }
      h2 em { font-style: italic; color: var(--red); }
      .sec-intro { font-family: var(--mono); font-size: 0.82rem; line-height: 1.75; color: var(--muted); max-width: 44rem; margin-top: 1.2rem; }
      .sec-intro strong { color: var(--ink); font-weight: 500; }

      .plates { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); margin-top: 2.4rem; }
      .plate { font-family: var(--mono); font-size: 0.82rem; line-height: 1.75; color: var(--muted); }
      .plate .no { display: block; font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); margin-bottom: 0.7rem; }
      .plate strong { color: var(--ink); font-weight: 500; }

      .contact { text-align: center; padding: clamp(3rem, 8vw, 6rem) 0; margin-top: auto; border-top: 1px solid var(--line); }
      .contact h2 { margin: 0 auto 1.2rem; }
      .contact .email { font-family: var(--mono); font-size: clamp(1.1rem, 3vw, 1.6rem); color: var(--red); text-decoration: none; }
      .contact .email:hover { color: var(--plum); }

      footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--wine); padding: 1.8rem 0 2rem; border-top: 1px solid var(--line); }

      @media (max-width: 820px) {
        h1 { font-size: clamp(2.4rem, 12vw, 3.6rem); }
        .plates { grid-template-columns: 1fr; gap: 1.6rem; }
        header .rooms { display: none; }
      }
    </style>

    <!-- Panel styles are GLOBAL: the panel's rows/labels/inputs are created in
         JS, so Astro's scoped selectors would never match them. -->
    <style is:global>
      /* Live tuning panel — matted-print card matching the Riso frame.
         Hidden until the visitor types the cheat-word "swarm". */
      #panel { display: none; }
      #panel.revealed { display: block; }
      #panel {
        position: fixed; top: 14px; right: 14px; z-index: 20;
        width: 252px; max-height: calc(100vh - 28px); overflow-y: auto;
        background: rgba(242,237,227,0.94); color: #221016;
        border: 1.5px solid #e8481f; border-radius: 2px;
        font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: 11px; line-height: 1.45;
        padding: 12px 14px; backdrop-filter: blur(3px);
        box-shadow: 0 8px 30px rgba(34,16,22,0.16);
      }
      #panel h3 { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #e8481f; margin-bottom: 11px; padding-bottom: 9px; border-bottom: 1px solid rgba(34,16,22,0.20); display: flex; justify-content: space-between; }
      #panel .row { margin-bottom: 13px; }
      #panel .row label { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 8px; margin-bottom: 6px; font-size: 10px; letter-spacing: 0.02em; color: #7a5a54; text-transform: uppercase; }
      #panel .row label b { color: #221016; font-weight: 500; text-transform: none; }
      /* Stylised range: thin plum-tinted rail with a red tick thumb */
      #panel input[type=range] { -webkit-appearance: none; appearance: none; display: block; width: 100%; height: 3px; margin: 0; background: rgba(34,16,22,0.20); border-radius: 2px; cursor: pointer; }
      #panel input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 8px; height: 15px; margin-top: -6px; background: #e8481f; border: none; border-radius: 1px; cursor: pointer; }
      #panel input[type=range]::-moz-range-thumb { width: 8px; height: 15px; background: #e8481f; border: none; border-radius: 1px; cursor: pointer; }
      #panel input[type=range]::-moz-range-track { height: 3px; background: rgba(34,16,22,0.20); border-radius: 2px; }
      #panel input[type=range]:hover::-webkit-slider-thumb { background: #221016; }
      #panel input[type=range]:hover::-moz-range-thumb { background: #221016; }
      #panel .btns { display: flex; gap: 8px; margin-top: 12px; }
      #panel button { flex: 1; font-family: inherit; font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; padding: 7px; border-radius: 2px; border: 1px solid rgba(34,16,22,0.20); background: transparent; color: #7a1f3d; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s; }
      #panel button:hover { border-color: #e8481f; background: #e8481f; color: #f2ede3; }
      #panel.collapsed .body { display: none; }
      #panel .toggle { cursor: pointer; color: #7a5a54; }
      #panel .toggle:hover { color: #e8481f; }
      #panel textarea { width: 100%; height: 60px; margin-top: 8px; font-family: inherit; font-size: 9px; background: rgba(34,16,22,0.05); color: #7a1f3d; border: 1px solid rgba(34,16,22,0.20); border-radius: 2px; display: none; }
    </style>
  </head>
  <body>
    <canvas id="bg"></canvas>
    <div id="panel">
      <h3><span>swarm tuning</span><span class="toggle" id="pt">[hide]</span></h3>
      <div class="body">
        <div id="sliders"></div>
        <div class="btns">
          <button id="copyCfg">copy config</button>
          <button id="resetCfg">reset</button>
        </div>
        <textarea id="cfgOut" readonly></textarea>
      </div>
    </div>
    <div class="frame">
      <div class="mat">
        <header>
          <span class="brand">knyta</span>
          <span class="rooms">
            <a href="#work">How it's made</a>
            <a href="#promise">The promise</a>
            <a href="mailto:hello@knyta.net">Contact</a>
          </span>
          <span>No. 06 — Field</span>
        </header>

        <section class="hero">
          <p class="eyebrow"><b>knyta</b> /ˈknŷːta/ <i>verb, Swedish</i> — to tie; to knot; to bind together.</p>
          <h1>Customer data arrives messy. Yours lands <em>clean</em>.</h1>
          <p class="lede">Knyta is an <strong>AI-assisted data-ingestion engine</strong>. It turns the CSVs, exports and odd files other people send you into clean rows where they belong.</p>
          <div class="cta">
            <a class="tickets" href="mailto:hello@knyta.net">hello@knyta.net</a>
            <a class="ghost" href="#work">see how it's made ↓</a>
          </div>
          <p class="hint">move your cursor — the swarm scatters away from it</p>
        </section>

        <section class="block" id="work">
          <p class="sec-no">01 — How it's made</p>
          <h2>AI writes the pipeline once. <em>Boring</em>, deterministic code runs it forever.</h2>
          <p class="sec-intro">AI is used where it is genuinely good — reading a messy file nobody has seen before and writing the code to handle it. Everything after that is <strong>pinned, replayable, and audited</strong>. Same file in, same rows out.</p>
        </section>

        <section class="block" id="promise">
          <p class="sec-no">02 — The promise</p>
          <div class="plates">
            <p class="plate">
              <span class="no">Plate I — Legible</span>
              Every pipeline is plain, readable code with an explicit validation contract. Open it, diff it, see exactly what happens to every column. <strong>No black boxes.</strong>
            </p>
            <p class="plate">
              <span class="no">Plate II — Honest</span>
              A value that does not validate is <strong>flagged, not guessed</strong>. A delivery whose outcome is unknown is quarantined, not reported clean. No surprises three weeks downstream.
            </p>
          </div>
        </section>

        <section class="contact">
          <p class="sec-no">03 — Contact</p>
          <h2>Tell us about your <em>worst</em> file.</h2>
          <a class="email" href="mailto:hello@knyta.net?subject=Our%20worst%20file">hello@knyta.net</a>
        </section>

        <footer>
          <span>© 2026 Knyta · built in Sweden</span>
          <span>no cookies · no trackers</span>
        </footer>
      </div>
    </div>

    <script>
      import { startDither } from "../../scripts/dither.js";
      const c = document.getElementById("bg");
      // Size the document-anchored canvas to the full page height. Collapse it
      // first: an absolutely-positioned element still counts toward scrollHeight,
      // so measuring while it's tall would let the page grow past its content.
      const sizeBg = () => {
        if (!c) return;
        c.style.height = "0px";
        c.style.height = document.documentElement.scrollHeight + "px";
      };
      sizeBg();
      const ctrl = c && startDither(c, {
        respectReducedMotion: false,
        interactive: true,
        scroll: true,
        scrollFactor: 0.3,
        palette: ["#f2ede3", "#f0d9ae", "#ecc07f", "#e8481f"],
        field: "boids",
        matrix: 8,
        speed: 1,
        boidCount: 128,
        scale: 4,
        cfg: {
          maxSpeed: 0.0079, maxForce: 0.00036, perception: 0.27, separationDist: 0.075,
          cohesion: 1, alignment: 1.05, separation: 2.25, flee: 9.4, fleeRadius: 0.52,
          centering: 0.0004, homeSpeed: 0.155, edgeRepel: 0.0028, edgeMargin: 0.065,
          damping: 0.96, splatSize: 0.025, splatIntensity: 2.4, blur: 0.1, blurPasses: 2, holdMs: 1,
        },
      });

      // Keep the canvas matched to the page height, and re-measure once fonts /
      // images settle (forcing the engine to recompute its buffers).
      window.addEventListener("resize", sizeBg);
      window.addEventListener("load", () => { sizeBg(); if (ctrl) ctrl.setScale(ctrl.getScale()); });

      if (ctrl) {
        // [label, key, min, max, step]. Special keys: count, scale.
        const SPEC = [
          ["density (agents / ref screen)", "count", 5, 300, 1],
          ["dither dot size (scale)", "scale", 2, 12, 1],
          ["max speed", "maxSpeed", 0.0005, 0.012, 0.0002],
          ["max force", "maxForce", 0.00004, 0.001, 0.00002],
          ["perception radius", "perception", 0.05, 0.7, 0.01],
          ["separation dist", "separationDist", 0.01, 0.16, 0.005],
          ["cohesion", "cohesion", 0, 4, 0.05],
          ["alignment", "alignment", 0, 3, 0.05],
          ["separation", "separation", 0, 4, 0.05],
          ["flee strength", "flee", 0, 10, 0.1],
          ["flee radius", "fleeRadius", 0.05, 0.6, 0.01],
          ["damping (settle)", "damping", 0.6, 1, 0.01],
          ["centering (home pull)", "centering", 0, 0.004, 0.0001],
          ["home wander speed", "homeSpeed", 0, 0.3, 0.005],
          ["edge repel strength", "edgeRepel", 0, 0.005, 0.0001],
          ["edge repel margin", "edgeMargin", 0.01, 0.25, 0.005],
          ["blob size (splat)", "splatSize", 0.01, 0.16, 0.005],
          ["blob intensity", "splatIntensity", 0.2, 6, 0.1],
          ["blur amount", "blur", 0, 0.16, 0.005],
          ["blur passes (roundness)", "blurPasses", 0, 6, 1],
          ["colour hold (ms, anti-flicker)", "holdMs", 1, 10, 0.5],
        ];
        const STORE = "knyta-swarm-cfg";
        const defaults = { count: ctrl.getCount(), scale: ctrl.getScale(), ...JSON.parse(JSON.stringify(ctrl.cfg)) };
        const get = (k) => k === "count" ? ctrl.getCount() : k === "scale" ? ctrl.getScale() : ctrl.cfg[k];
        const set = (k, v) => {
          if (k === "count") ctrl.setCount(v);
          else if (k === "scale") ctrl.setScale(v);
          else ctrl.cfg[k] = v;
        };
        const save = () => {
          const o = {}; for (const [, key] of SPEC) o[key] = get(key);
          try { localStorage.setItem(STORE, JSON.stringify(o)); } catch (e) {}
        };
        // Restore a previously-tuned config so reloads (incl. code edits) don't wipe it.
        try {
          const saved = JSON.parse(localStorage.getItem(STORE) || "null");
          if (saved) for (const [, key] of SPEC) if (key in saved && typeof saved[key] === "number") set(key, saved[key]);
        } catch (e) {}
        const fmt = (v) => Math.abs(v) < 0.01 && v !== 0 ? v.toExponential(1) : (Math.round(v * 1000) / 1000);
        const box = document.getElementById("sliders");
        const readouts = {};
        for (const [label, key, min, max, step] of SPEC) {
          const row = document.createElement("div"); row.className = "row";
          const lab = document.createElement("label");
          const nm = document.createElement("span"); nm.textContent = label;
          const val = document.createElement("b"); val.textContent = fmt(get(key)); readouts[key] = val;
          lab.appendChild(nm); lab.appendChild(val);
          const inp = document.createElement("input");
          inp.type = "range"; inp.min = min; inp.max = max; inp.step = step; inp.value = get(key);
          inp.addEventListener("input", () => { const v = parseFloat(inp.value); set(key, v); val.textContent = fmt(v); save(); });
          row.appendChild(lab); row.appendChild(inp); box.appendChild(row);
        }
        const out = document.getElementById("cfgOut");
        document.getElementById("copyCfg").addEventListener("click", () => {
          const dump = { boidCount: ctrl.getCount(), scale: ctrl.getScale(), cfg: ctrl.cfg };
          const txt = JSON.stringify(dump, null, 2);
          out.style.display = "block"; out.value = txt;
          navigator.clipboard && navigator.clipboard.writeText(txt).catch(() => {});
        });
        document.getElementById("resetCfg").addEventListener("click", () => {
          try { localStorage.removeItem(STORE); } catch (e) {}
          for (const [, key] of SPEC) {
            set(key, defaults[key]);
            const inp = readouts[key].closest(".row").querySelector("input");
            inp.value = defaults[key]; readouts[key].textContent = fmt(defaults[key]);
          }
        });
        const panel = document.getElementById("panel");
        document.getElementById("pt").addEventListener("click", () => {
          panel.classList.toggle("collapsed");
          document.getElementById("pt").textContent = panel.classList.contains("collapsed") ? "[show]" : "[hide]";
        });

        // Hidden cheat-word: type "swarm" to toggle the panel (again to hide it).
        let typed = "";
        window.addEventListener("keydown", (e) => {
          if (e.key && e.key.length === 1) {
            typed = (typed + e.key.toLowerCase()).slice(-5);
            if (typed === "swarm") { panel.classList.toggle("revealed"); typed = ""; }
          }
        });
      }
    </script>
  </body>
</html>

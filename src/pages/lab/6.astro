---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Knyta — Living Field</title>
    <style>
      :root {
        --cream: #f2ede3;
        --plum: #221016;
        --wine: #7a1f3d;
        --red: #e8481f;
        --gold: #f0a24a;
        --ink: #221016;
        --muted: #7a5a54;
        --line: rgba(34,16,22,0.20);
        --serif: "Hoefler Text", "Baskerville", "Iowan Old Style", Palatino, Georgia, serif;
        --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
      }
      * { box-sizing: border-box; margin: 0; }
      html { background: var(--cream); }
      body { background: transparent; color: var(--ink); font-family: var(--serif); font-size: 1.0625rem; line-height: 1.55; -webkit-font-smoothing: antialiased; }
      a { color: inherit; }

      /* Page-wide dithered swarm. Absolute (not fixed) so it's pinned to the
         document and scrolls with the page; its height is set to the full page
         height in JS. The field's low end is the page cream, so it reads as a
         soft warm presence, not a slab. */
      #bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 0;
        display: block;
        image-rendering: pixelated; /* crisp dither dots — the blur is in the field, not here */
        pointer-events: none;
      }

      .frame { position: relative; z-index: 1; min-height: 100vh; padding: clamp(0.9rem, 2.4vw, 1.9rem); }
      .mat {
        border: 1.5px solid var(--red);
        min-height: calc(100vh - clamp(1.8rem, 4.8vw, 3.8rem));
        padding: 0 clamp(1.4rem, 4.5vw, 3.5rem);
        display: flex;
        flex-direction: column;
      }

      header {
        display: flex; justify-content: space-between; align-items: baseline;
        font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--wine);
        padding: 1.6rem 0; border-bottom: 1px solid var(--line);
      }
      header .brand { font-family: var(--serif); font-style: italic; font-size: 1.5rem; letter-spacing: -0.01em; text-transform: none; color: var(--red); line-height: 1; }
      header .rooms { display: flex; gap: 1.6rem; }
      header .rooms a { text-decoration: none; }
      header .rooms a:hover { color: var(--red); }

      .eyebrow { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 2.4rem 0 1.4rem; }
      .eyebrow b { color: var(--red); font-weight: 500; }
      .eyebrow i { font-style: italic; text-transform: none; letter-spacing: 0; }

      .hero { padding: clamp(1.5rem, 5vw, 4rem) 0 clamp(2rem, 6vw, 5rem); }
      h1 {
        font-family: var(--serif); font-weight: 600;
        font-size: clamp(2.8rem, 8.5vw, 6.5rem); line-height: 0.94; letter-spacing: -0.02em;
        max-width: 15ch; color: var(--plum);
      }
      h1 em { font-style: italic; color: var(--red); }
      .lede { font-family: var(--serif); font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.5; max-width: 34rem; margin-top: 1.8rem; color: var(--ink); }
      .lede strong { color: var(--red); font-weight: 600; font-style: italic; }
      .cta { margin-top: 2.2rem; display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; }
      .tickets { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; background: var(--red); color: var(--cream); padding: 0.85rem 1.6rem; border-radius: 2px; }
      .tickets:hover { background: var(--plum); }
      .ghost { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
      .ghost:hover { color: var(--red); }
      .hint { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--muted); margin-top: 1.4rem; opacity: 0.8; }

      section.block { padding: clamp(2.5rem, 6vw, 5rem) 0; border-top: 1px solid var(--line); }
      .sec-no { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); margin-bottom: 1rem; }
      h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(1.8rem, 4vw, 2.9rem); line-height: 1.05; letter-spacing: -0.015em; max-width: 24ch; }
      h2 em { font-style: italic; color: var(--red); }
      .sec-intro { font-family: var(--mono); font-size: 0.82rem; line-height: 1.75; color: var(--muted); max-width: 44rem; margin-top: 1.2rem; }
      .sec-intro strong { color: var(--ink); font-weight: 500; }

      .plates { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); margin-top: 2.4rem; }
      .plate { font-family: var(--mono); font-size: 0.82rem; line-height: 1.75; color: var(--muted); }
      .plate .no { display: block; font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); margin-bottom: 0.7rem; }
      .plate strong { color: var(--ink); font-weight: 500; }

      .contact { text-align: center; padding: clamp(3rem, 8vw, 6rem) 0; margin-top: auto; border-top: 1px solid var(--line); }
      .contact h2 { margin: 0 auto 1.2rem; }
      .contact .email { font-family: var(--mono); font-size: clamp(1.1rem, 3vw, 1.6rem); color: var(--red); text-decoration: none; }
      .contact .email:hover { color: var(--plum); }

      footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--wine); padding: 1.8rem 0 2rem; border-top: 1px solid var(--line); }

      @media (max-width: 820px) {
        h1 { font-size: clamp(2.4rem, 12vw, 3.6rem); }
        .plates { grid-template-columns: 1fr; gap: 1.6rem; }
        header .rooms { display: none; }
      }
    </style>
  </head>
  <body>
    <canvas id="bg"></canvas>
    <div class="frame">
      <div class="mat">
        <header>
          <span class="brand">knyta</span>
          <span class="rooms">
            <a href="#work">How it's made</a>
            <a href="#promise">The promise</a>
            <a href="mailto:hello@knyta.net">Contact</a>
          </span>
          <span>No. 06 — Field</span>
        </header>

        <section class="hero">
          <p class="eyebrow"><b>knyta</b> /ˈknŷːta/ <i>verb, Swedish</i> — to tie; to knot; to bind together.</p>
          <h1>Customer data arrives messy. Yours lands <em>clean</em>.</h1>
          <p class="lede">Knyta is an <strong>AI-assisted data-ingestion engine</strong>. It turns the CSVs, exports and odd files other people send you into clean rows where they belong.</p>
          <div class="cta">
            <a class="tickets" href="mailto:hello@knyta.net">hello@knyta.net</a>
            <a class="ghost" href="#work">see how it's made ↓</a>
          </div>
          <p class="hint">move your cursor — the swarm scatters away from it</p>
        </section>

        <section class="block" id="work">
          <p class="sec-no">01 — How it's made</p>
          <h2>AI writes the pipeline once. <em>Boring</em>, deterministic code runs it forever.</h2>
          <p class="sec-intro">AI is used where it is genuinely good — reading a messy file nobody has seen before and writing the code to handle it. Everything after that is <strong>pinned, replayable, and audited</strong>. Same file in, same rows out.</p>
        </section>

        <section class="block" id="promise">
          <p class="sec-no">02 — The promise</p>
          <div class="plates">
            <p class="plate">
              <span class="no">Plate I — Legible</span>
              Every pipeline is plain, readable code with an explicit validation contract. Open it, diff it, see exactly what happens to every column. <strong>No black boxes.</strong>
            </p>
            <p class="plate">
              <span class="no">Plate II — Honest</span>
              A value that does not validate is <strong>flagged, not guessed</strong>. A delivery whose outcome is unknown is quarantined, not reported clean. No surprises three weeks downstream.
            </p>
          </div>
        </section>

        <section class="contact">
          <p class="sec-no">03 — Contact</p>
          <h2>Tell us about your <em>worst</em> file.</h2>
          <a class="email" href="mailto:hello@knyta.net?subject=Our%20worst%20file">hello@knyta.net</a>
        </section>

        <footer>
          <span>© 2026 Knyta · built in Sweden</span>
          <span>no cookies · no trackers</span>
        </footer>
      </div>
    </div>

    <script>
      import { startDither } from "../../scripts/dither.js";
      const c = document.getElementById("bg");
      // Size the document-anchored canvas to the full page height. Collapse it
      // first: an absolutely-positioned element still counts toward scrollHeight,
      // so measuring while it's tall would let the page grow past its content.
      const sizeBg = () => {
        if (!c) return;
        c.style.height = "0px";
        c.style.height = document.documentElement.scrollHeight + "px";
      };
      sizeBg();
      const ctrl = c && startDither(c, {
        respectReducedMotion: false,
        interactive: true,
        scroll: true,
        scrollFactor: 0.3,
        palette: ["#f2ede3", "#f0d9ae", "#ecc07f", "#e8481f"],
        field: "boids",
        matrix: 8,
        speed: 1,
        boidCount: 128,
        scale: 4,
        cfg: {
          maxSpeed: 0.0079, maxForce: 0.00036, perception: 0.27, separationDist: 0.075,
          cohesion: 1, alignment: 1.05, separation: 2.25, flee: 9.4, fleeRadius: 0.52,
          centering: 0.0004, homeSpeed: 0.155, edgeRepel: 0.0028, edgeMargin: 0.065,
          damping: 0.96, splatSize: 0.025, splatIntensity: 2.4, blur: 0.1, blurPasses: 2, holdMs: 1,
        },
      });

      // Keep the canvas matched to the page height, and re-measure once fonts /
      // images settle (forcing the engine to recompute its buffers).
      window.addEventListener("resize", sizeBg);
      window.addEventListener("load", () => { sizeBg(); if (ctrl) ctrl.setScale(ctrl.getScale()); });
    </script>
  </body>
</html>

        </footer>
      </div>
    </div>

    <script>
      import { startDither } from "../scripts/dither.js";
      const c = document.getElementById("bg");
      // Size the document-anchored canvas to the full page height. Collapse it
      // first: an absolutely-positioned element still counts toward scrollHeight,
      // so measuring while it's tall would let the page grow past its content.
      const sizeBg = () => {
        if (!c) return;
        c.style.height = "0px";
        c.style.height = document.documentElement.scrollHeight + "px";
      };
      sizeBg();
      const ctrl = c && startDither(c, {
        interactive: true,
        scroll: true,
        scrollFactor: 0.3,
        palette: ["#f2ede3", "#f0d9ae", "#ecc07f", "#e8481f"],
        field: "boids",
        matrix: 8,
        speed: 1,
        stepsPerSec: 16,
        boidCount: 128,
        scale: 4,
        cfg: {
          maxSpeed: 0.0085, maxForce: 0.00036, perception: 0.27, separationDist: 0.075,
          cohesion: 0.8, alignment: 1.05, separation: 2.25, flee: 9.4, fleeRadius: 0.56,
          centering: 0.0003, homeSpeed: 0.155, offscreenPull: 10, offscreenSpeed: 4,
          edgeRepel: 0.0028, edgeMargin: 0.065,
          damping: 0.96, splatSize: 0.025, splatIntensity: 1.9, blur: 0.1, blurPasses: 2, holdMs: 140,
        },
      });
      // Keep the canvas matched to the page height, and re-measure once fonts
      // settle (setScale forces the engine to recompute its buffers).
      window.addEventListener("resize", sizeBg);
      window.addEventListener("load", () => { sizeBg(); if (ctrl) ctrl.setScale(ctrl.getScale()); });

      // Hidden live tuning panel. Invisible to visitors; type the cheat-word
      // "swarm" (physical keyboard) to toggle it. Edits apply live and persist to
      // localStorage per device; "copy config" dumps JSON to paste back here.
      if (ctrl) {
        // [label, key, min, max, step]. Special keys: count, scale.
        const SPEC = [
          ["density (agents / ref screen)", "count", 5, 300, 1],
          ["dither dot size (scale)", "scale", 2, 12, 1],
          ["simulation steps / sec", "stepRate", 1, 60, 1],
          ["max speed", "maxSpeed", 0.0005, 0.012, 0.0002],
          ["max force", "maxForce", 0.00004, 0.001, 0.00002],
          ["perception radius", "perception", 0.05, 0.7, 0.01],
          ["separation dist", "separationDist", 0.01, 0.16, 0.005],
          ["cohesion", "cohesion", 0, 4, 0.05],
          ["alignment", "alignment", 0, 3, 0.05],
          ["separation", "separation", 0, 4, 0.05],
          ["flee strength", "flee", 0, 10, 0.1],
          ["flee radius", "fleeRadius", 0.05, 0.6, 0.01],
          ["damping (settle)", "damping", 0.6, 1, 0.01],
          ["centering (home pull)", "centering", 0, 0.004, 0.0001],
          ["home wander speed", "homeSpeed", 0, 0.3, 0.005],
          ["off-screen home pull", "offscreenPull", 0, 40, 0.5],
          ["off-screen speed limit (x)", "offscreenSpeed", 1, 10, 0.25],
          ["edge repel strength", "edgeRepel", 0, 0.005, 0.0001],
          ["edge repel margin", "edgeMargin", 0.01, 0.25, 0.005],
          ["blob size (splat)", "splatSize", 0.01, 0.16, 0.005],
          ["blob intensity", "splatIntensity", 0.2, 6, 0.1],
          ["blur amount", "blur", 0, 0.16, 0.005],
          ["blur passes (roundness)", "blurPasses", 0, 6, 1],
          ["colour hold (ms, anti-flicker)", "holdMs", 0, 1000, 5],
        ];
        const STORE = "knyta-swarm-cfg";
        const defaults = { count: ctrl.getCount(), scale: ctrl.getScale(), stepRate: ctrl.getStepRate(), ...JSON.parse(JSON.stringify(ctrl.cfg)) };
        const get = (k) => k === "count" ? ctrl.getCount() : k === "scale" ? ctrl.getScale() : k === "stepRate" ? ctrl.getStepRate() : ctrl.cfg[k];
        const set = (k, v) => {
          if (k === "count") ctrl.setCount(v);
          else if (k === "scale") ctrl.setScale(v);
          else if (k === "stepRate") ctrl.setStepRate(v);
          else ctrl.cfg[k] = v;
        };
        const save = () => {
          const o = {}; for (const [, key] of SPEC) o[key] = get(key);
          try { localStorage.setItem(STORE, JSON.stringify(o)); } catch (e) {}
        };
        // Restore a previously-tuned config so reloads (incl. code edits) don't wipe it.
        try {
          const saved = JSON.parse(localStorage.getItem(STORE) || "null");
          if (saved) for (const [, key] of SPEC) if (key in saved && typeof saved[key] === "number") set(key, saved[key]);
        } catch (e) {}
        const fmt = (v) => Math.abs(v) < 0.01 && v !== 0 ? v.toExponential(1) : (Math.round(v * 1000) / 1000);
        const box = document.getElementById("sliders");
        const readouts = {};
        for (const [label, key, min, max, step] of SPEC) {
          const row = document.createElement("div"); row.className = "row";
          const lab = document.createElement("label");
          const nm = document.createElement("span"); nm.textContent = label;
          const val = document.createElement("b"); val.textContent = fmt(get(key)); readouts[key] = val;
          lab.appendChild(nm); lab.appendChild(val);
          const inp = document.createElement("input");
          inp.type = "range"; inp.min = min; inp.max = max; inp.step = step; inp.value = get(key);
          inp.addEventListener("input", () => { const v = parseFloat(inp.value); set(key, v); val.textContent = fmt(v); save(); });
          row.appendChild(lab); row.appendChild(inp); box.appendChild(row);
        }
        const out = document.getElementById("cfgOut");
        document.getElementById("copyCfg").addEventListener("click", () => {
          const dump = { boidCount: ctrl.getCount(), scale: ctrl.getScale(), stepsPerSec: Math.round(ctrl.getStepRate()), cfg: ctrl.cfg };
          const txt = JSON.stringify(dump, null, 2);
          out.style.display = "block"; out.value = txt;
          navigator.clipboard && navigator.clipboard.writeText(txt).catch(() => {});
        });
        document.getElementById("resetCfg").addEventListener("click", () => {
          try { localStorage.removeItem(STORE); } catch (e) {}
          for (const [, key] of SPEC) {
            set(key, defaults[key]);
            const inp = readouts[key].closest(".row").querySelector("input");
            inp.value = defaults[key]; readouts[key].textContent = fmt(defaults[key]);
          }
        });
        const panel = document.getElementById("panel");
        document.getElementById("pt").addEventListener("click", () => {
          panel.classList.toggle("collapsed");
          document.getElementById("pt").textContent = panel.classList.contains("collapsed") ? "[show]" : "[hide]";
        });

        // Hidden cheat-word: type "swarm" to toggle the panel (again to hide it).
        let typed = "";
        window.addEventListener("keydown", (e) => {
          if (e.key && e.key.length === 1) {
            typed = (typed + e.key.toLowerCase()).slice(-5);
            if (typed === "swarm") { panel.classList.toggle("revealed"); typed = ""; }
          }
        });
      }
    </script>
  </body>
</html>

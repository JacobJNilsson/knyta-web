---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
// EB Garamond: a classical old-style serif in the same lineage as Hoefler Text
// (the previous Apple-only stack), self-hosted so the brand looks the same
// everywhere. Variable weight (400-800) + a true italic, upright and italic.
import "@fontsource-variable/eb-garamond/wght.css";
import "@fontsource-variable/eb-garamond/wght-italic.css";

const title = "Knyta — messy customer data in, clean data out";
const description =
  "Knyta is an AI-assisted data-ingestion engine. It turns the CSVs, exports, and one-off files other people send you into clean rows in your database — through pipelines you can read, replay, and trust. When a sender changes their format, the pipeline updates itself. Postgres today; more destinations on the way.";
const site = "https://knyta.net";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}/#org`,
      name: "Knyta",
      url: `${site}/`,
      email: "hello@knyta.net",
      logo: `${site}/favicon.svg`,
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: `${site}/`,
      name: "Knyta",
      description,
      inLanguage: "en",
      publisher: { "@id": `${site}/#org` },
    },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://knyta.net/" />
    <meta name="theme-color" content="#f2ede3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://knyta.net/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Knyta" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Knyta — customer data arrives messy, yours lands clean" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <style>
      :root {
        --cream: #f2ede3;
        --raised: #f8f4ea;
        --plum: #221016;
        --wine: #7a1f3d;
        --red: #e8481f;
        --gold: #f0a24a;
        --ink: #221016;
        --muted: #7a5a54;
        --good: #3d6b3f;
        --line: rgba(34,16,22,0.20);
        --line-soft: rgba(34,16,22,0.10);
        --display: "EB Garamond Variable", "Hoefler Text", "Iowan Old Style", Palatino, Georgia, serif;
        --serif: "EB Garamond Variable", "Hoefler Text", "Iowan Old Style", Palatino, Georgia, serif;
        --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
      }
      * { box-sizing: border-box; margin: 0; }
      html { background: var(--cream); }
      body { background: transparent; color: var(--ink); font-family: var(--serif); font-size: 1.0625rem; line-height: 1.55; -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      ::selection { background: var(--red); color: var(--cream); }

      /* Page-wide dithered swarm. Absolute (not fixed) so it's pinned to the
         document and scrolls with the page; its height is set to the full page
         height in JS. The field's low end is the page cream, so it reads as a
         soft warm presence rather than a slab. */
      #bg {
        position: absolute; top: 0; left: 0; width: 100%; z-index: 0;
        display: block; image-rendering: pixelated; pointer-events: none;
      }

      .frame { position: relative; z-index: 1; min-height: 100vh; padding: clamp(0.9rem, 2.4vw, 1.9rem); }
      .mat {
        /* Matted "paper" over the swarm: a translucent cream fill lifts the text
           off the busy warm core for legibility, while the swarm stays fully
           vivid in the frame margin around the mat and shows softly through here.
           No effect on the letterforms themselves. */
        background: rgba(242, 237, 227, 0.5);
        border: 1.5px solid var(--red);
        min-height: calc(100vh - clamp(1.8rem, 4.8vw, 3.8rem));
        padding: 0 clamp(1.4rem, 4.5vw, 3.5rem);
        display: flex; flex-direction: column;
      }

      header {
        display: flex; justify-content: space-between; align-items: baseline;
        font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--wine);
        padding: 1.6rem 0; border-bottom: 1px solid var(--line);
      }
      header .brand { font-family: var(--display); font-style: italic; font-size: 1.5rem; letter-spacing: -0.01em; text-transform: none; color: var(--red); line-height: 1; text-decoration: none; }
      header .rooms { display: flex; gap: 1.6rem; }
      header .rooms a { text-decoration: none; }
      header .rooms a:hover { color: var(--red); }

      section { padding: clamp(3rem, 7vw, 6rem) 0; border-top: 1px solid var(--line); }
      section:first-of-type { border-top: none; }
      .sec-no { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); margin-bottom: 1rem; }
      h2 { font-family: var(--display); font-weight: 500; font-size: clamp(1.9rem, 4.2vw, 3rem); line-height: 1.05; letter-spacing: -0.015em; max-width: 26ch; }
      h2 em { font-style: italic; color: var(--red); }
      .sec-intro { font-family: var(--mono); font-size: 0.84rem; line-height: 1.8; color: var(--muted); max-width: 44rem; margin-top: 1.4rem; }
      .sec-intro strong { color: var(--ink); font-weight: 500; }

      /* Hero */
      .hero { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 8vw, 6rem); }
      .eyebrow { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 1.6rem; }
      .eyebrow b { color: var(--red); font-weight: 500; }
      .eyebrow i { font-style: italic; text-transform: none; letter-spacing: 0; }
      h1 {
        font-family: var(--display); font-weight: 600;
        font-size: clamp(2.8rem, 8.5vw, 6.5rem); line-height: 0.94; letter-spacing: -0.02em;
        max-width: 15ch; color: var(--plum);
      }
      h1 em { font-style: italic; color: var(--red); }
      .lede { font-family: var(--serif); font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.5; max-width: 36rem; margin-top: 1.8rem; color: var(--ink); }
      .lede strong { color: var(--red); font-weight: 600; font-style: italic; }
      .cta { margin-top: 2.4rem; display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; }
      .cta-primary { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; background: var(--red); color: var(--cream); padding: 0.85rem 1.6rem; border-radius: 2px; }
      .cta-primary:hover { background: var(--plum); }
      .cta-ghost { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
      .cta-ghost:hover { color: var(--red); }

      /* Before / after demo */
      .demo { display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); gap: 1.1rem; align-items: stretch; margin-top: 2.6rem; }
      .card {
        background: var(--raised); border: 1px solid var(--line); border-radius: 4px;
        overflow: hidden; min-width: 0;
      }
      .card-bar {
        display: flex; justify-content: space-between; gap: 1rem;
        font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.04em; color: var(--muted);
        padding: 0.55rem 0.9rem; border-bottom: 1px solid var(--line-soft);
        background: rgba(34,16,22,0.04); white-space: nowrap; overflow-x: auto;
      }
      .card pre { padding: 0.9rem; overflow-x: auto; font-family: var(--mono); font-size: 0.72rem; line-height: 1.75; color: var(--ink); }
      .card .bad { color: var(--red); }
      .card .ok { color: var(--good); }
      .card .dim { color: var(--muted); }
      .arrow { display: flex; align-items: center; color: var(--red); }
      .arrow svg { width: 3rem; }
      .demo-note { font-family: var(--mono); font-size: 0.8rem; line-height: 1.8; color: var(--muted); max-width: 46rem; margin-top: 1.6rem; }
      .demo-note b { color: var(--ink); font-weight: 500; }

      /* Who it's for */
      .who { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,0.85fr); gap: clamp(2rem, 6vw, 4.5rem); align-items: start; margin-top: 2rem; }
      .who p { font-family: var(--serif); font-size: 1.0625rem; color: var(--ink); max-width: 40rem; }
      .who p + p { margin-top: 1.1rem; }
      .who strong { color: var(--red); font-weight: 600; font-style: italic; }
      .who ul { list-style: none; padding: 0; font-family: var(--mono); font-size: 0.82rem; line-height: 2.1; }
      .who .y::before { content: "→ "; color: var(--red); }
      .who .n { color: var(--muted); text-decoration: line-through; text-decoration-color: var(--red); }
      .who .y + .n { margin-top: 1rem; }

      /* How it works — timeline */
      .steps { list-style: none; padding: 0; position: relative; max-width: 46rem; margin-top: 2.4rem; }
      .steps::before { content: ""; position: absolute; left: 0.5rem; top: 0.6rem; bottom: 0.6rem; width: 2px; background: var(--red); opacity: 0.7; }
      .steps li { position: relative; padding: 0 0 2.4rem 2.5rem; }
      .steps li:last-child { padding-bottom: 0; }
      .steps li::before { content: ""; position: absolute; left: 0; top: 0.3rem; width: 1rem; height: 1rem; border-radius: 50%; background: var(--cream); border: 2px solid var(--red); }
      .steps li.last::before { background: var(--red); }
      .steps h3 { font-family: var(--display); font-weight: 500; font-size: 1.25rem; letter-spacing: -0.01em; margin-bottom: 0.4rem; color: var(--plum); }
      .steps h3 .tag { font-family: var(--mono); font-size: 0.6rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--red); border: 1px solid var(--red); border-radius: 99px; padding: 0.12rem 0.5rem; margin-left: 0.5rem; vertical-align: 0.18em; white-space: nowrap; }
      .steps p { font-family: var(--mono); font-size: 0.78rem; line-height: 1.85; color: var(--muted); }
      .steps p b { color: var(--ink); font-weight: 500; }

      /* Principles */
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; margin-top: 2.4rem; }
      .principle { background: var(--raised); border: 1px solid var(--line); border-radius: 4px; padding: 1.6rem 1.6rem 1.5rem; }
      .principle .num { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--red); display: block; margin-bottom: 0.9rem; }
      .principle h3 { font-family: var(--display); font-weight: 500; font-size: 1.2rem; letter-spacing: -0.01em; margin-bottom: 0.5rem; color: var(--plum); }
      .principle p { font-family: var(--mono); font-size: 0.76rem; line-height: 1.85; color: var(--muted); }

      /* Contact */
      .contact { text-align: center; margin-top: auto; }
      .contact h2 { margin: 0 auto 1.2rem; }
      .contact p { font-family: var(--mono); font-size: 0.84rem; line-height: 1.85; color: var(--muted); max-width: 40rem; margin: 0 auto 2rem; }
      /* The confidentiality note answers the one objection that stops a reader
         from sending a real customer file. It sits quieter than the ask. */
      .contact .fineprint { font-size: 0.74rem; max-width: 36rem; opacity: 0.85; }
      .contact .email { font-family: var(--mono); font-size: clamp(1.1rem, 3vw, 1.6rem); color: var(--red); text-decoration: none; }
      .contact .email:hover { color: var(--plum); }

      footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--wine); padding: 1.8rem 0 2rem; border-top: 1px solid var(--line); }

      @media (max-width: 820px) {
        h1 { font-size: clamp(2.4rem, 12vw, 3.6rem); }
        .demo { grid-template-columns: 1fr; }
        .arrow { justify-content: center; }
        .arrow svg { transform: rotate(90deg); }
        .who, .grid { grid-template-columns: 1fr; }
        header .rooms { display: none; }
      }
    </style>

    <!-- Panel styles are GLOBAL: the panel's rows/labels/inputs are created in
         JS, so Astro's scoped selectors would never match them. Hidden until the
         visitor types the cheat-word "swarm". -->
    <style is:global>
      #panel { display: none; }
      #panel.revealed { display: block; }
      #panel {
        position: fixed; top: 14px; right: 14px; z-index: 20;
        width: 252px; max-height: calc(100vh - 28px); overflow-y: auto;
        background: rgba(242,237,227,0.94); color: #221016;
        border: 1.5px solid #e8481f; border-radius: 2px;
        font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: 11px; line-height: 1.45;
        padding: 12px 14px; backdrop-filter: blur(3px);
        box-shadow: 0 8px 30px rgba(34,16,22,0.16);
      }
      #panel h3 { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #e8481f; margin-bottom: 11px; padding-bottom: 9px; border-bottom: 1px solid rgba(34,16,22,0.20); display: flex; justify-content: space-between; }
      #panel .row { margin-bottom: 13px; }
      #panel .row label { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 8px; margin-bottom: 6px; font-size: 10px; letter-spacing: 0.02em; color: #7a5a54; text-transform: uppercase; }
      #panel .row label b { color: #221016; font-weight: 500; text-transform: none; }
      #panel input[type=range] { -webkit-appearance: none; appearance: none; display: block; width: 100%; height: 3px; margin: 0; background: rgba(34,16,22,0.20); border-radius: 2px; cursor: pointer; }
      #panel input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 8px; height: 15px; margin-top: -6px; background: #e8481f; border: none; border-radius: 1px; cursor: pointer; }
      #panel input[type=range]::-moz-range-thumb { width: 8px; height: 15px; background: #e8481f; border: none; border-radius: 1px; cursor: pointer; }
      #panel input[type=range]::-moz-range-track { height: 3px; background: rgba(34,16,22,0.20); border-radius: 2px; }
      #panel input[type=range]:hover::-webkit-slider-thumb { background: #221016; }
      #panel input[type=range]:hover::-moz-range-thumb { background: #221016; }
      #panel .btns { display: flex; gap: 8px; margin-top: 12px; }
      #panel button { flex: 1; font-family: inherit; font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; padding: 7px; border-radius: 2px; border: 1px solid rgba(34,16,22,0.20); background: transparent; color: #7a1f3d; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s; }
      #panel button:hover { border-color: #e8481f; background: #e8481f; color: #f2ede3; }
      #panel.collapsed .body { display: none; }
      #panel .toggle { cursor: pointer; color: #7a5a54; }
      #panel .toggle:hover { color: #e8481f; }
      #panel textarea { width: 100%; height: 60px; margin-top: 8px; font-family: inherit; font-size: 9px; background: rgba(34,16,22,0.05); color: #7a1f3d; border: 1px solid rgba(34,16,22,0.20); border-radius: 2px; display: none; }
    </style>
  </head>
  <body>
    <canvas id="bg" aria-hidden="true"></canvas>
    <div id="panel">
      <h3><span>swarm tuning</span><span class="toggle" id="pt">[hide]</span></h3>
      <div class="body">
        <div id="sliders"></div>
        <div class="btns">
          <button id="copyCfg">copy config</button>
          <button id="resetCfg">reset</button>
        </div>
        <textarea id="cfgOut" readonly></textarea>
      </div>
    </div>
    <div class="frame">
      <div class="mat">
        <header>
          <a class="brand" href="/">knyta</a>
          <span class="rooms">
            <a href="#how">How it works</a>
            <a href="#principles">Principles</a>
            <a href="mailto:hello@knyta.net">Contact</a>
          </span>
          <span>Built in Sweden</span>
        </header>

        <section class="hero">
          <p class="eyebrow"><b>knyta</b> /ˈknŷːta/ <i>verb, Swedish</i> — to tie; to knot; to bind together.</p>
          <h1>Their export is a mess. Your table <em>isn't</em>.</h1>
          <p class="lede">Knyta is an <strong>AI-assisted data-ingestion engine</strong>. It turns the CSVs, exports and one-off files other people send you into clean rows in your database — through pipelines you can <strong>read, replay and trust</strong>. And when a sender changes their format, <strong>the pipeline updates itself</strong>. You approve; nobody rewrites scripts at midnight.</p>
          <div class="cta">
            <a class="cta-primary" href="mailto:hello@knyta.net?subject=Our%20worst%20file">Send us your worst file →</a>
            <a class="cta-ghost" href="#problem">see the problem ↓</a>
          </div>
        </section>

        <section id="problem">
          <p class="sec-no">01 — The problem</p>
          <h2>Every file someone sends you is somebody's Tuesday evening.</h2>
          <p class="sec-intro">Your work runs on data other people produce, and it arrives as <strong>whatever their system happened to export</strong>: headers on line four, decimal commas, three date formats in one column, a TOTAL row at the bottom. Generic ETL tools assume clean input. Reality doesn't, so someone cleans it by hand. Usually you.</p>

          <div class="demo">
            <div class="card">
              <div class="card-bar"><span>orders_export_FINAL(3).csv</span><span>as received</span></div>
              <pre><code><span class="dim">;;Kundrapport,,</span>
<span class="dim">Genererad:,</span><span class="bad">12/1/2026</span><span class="dim">,,</span>
<span class="dim">,,,</span>
ORDER NO,customer,Amount ,date
<span class="bad">10 234</span>,Acme AB,<span class="bad">"1 024,50"</span>,2026-01-12
10235,<span class="bad">acme ab</span>,980.00,<span class="bad">12/01/2026</span>
10236,Beta GmbH,<span class="bad"></span>,<span class="bad">13.1.2026</span>
<span class="bad">TOTAL,,"2 004,50",</span></code></pre>
            </div>
            <div class="arrow" aria-hidden="true">
              <svg viewBox="0 0 56 24" fill="none">
                <path d="M11.1 12.2 L12.1 12.4 L13 12.5 L14 12.6 L15 12.6 L16 12.6 L17 12.5 L18 12.3 L18.9 12.1 L19.8 11.8 L20.6 11.5 L21.4 11.1 L22.1 10.7 L22.8 10.3 L23.4 9.8 L23.9 9.4 L24.3 8.9 L24.7 8.4 L24.9 7.9 L25.1 7.4 L25.2 6.9 L25.2 6.4 L25.2 6 L25.1 5.6 L24.9 5.3 L24.7 5 L24.4 4.7 L24.1 4.5 L23.7 4.4 L23.4 4.3 L23 4.2 L22.6 4.3 L22.3 4.4 L21.9 4.5 L21.6 4.7 L21.3 5 L21.1 5.3 L20.9 5.6 L20.8 6 L20.8 6.4 L20.8 6.9 L20.9 7.4 L21.1 7.9 L21.3 8.4 L21.7 8.9 L22.1 9.4 L22.6 9.8 L23.2 10.3 L23.9 10.7 L24.6 11.1 L25.4 11.5 L26.2 11.8 L27.2 11.8 L28.2 11.8 L29.2 11.9 L30.2 11.9 L31.2 11.9 L32.2 12 L33.2 12 L34.2 12 L43 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M37 6.5 L 44.5 12 L 37 17.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
            <div class="card">
              <div class="card-bar"><span>public.orders</span><span>as delivered</span></div>
              <pre><code><span class="dim"> order_no │ customer_id │ amount  │ ordered_at</span>
<span class="dim">──────────┼─────────────┼─────────┼──────────</span>
 10234    │ cus_8f3a    │ <span class="ok">1024.50</span> │ <span class="ok">2026-01-12</span>
 10235    │ cus_8f3a    │  980.00 │ <span class="ok">2026-01-12</span>
 10236    │ cus_91bb    │ <span class="bad">flagged</span> │ <span class="ok">2026-01-13</span></code></pre>
            </div>
          </div>
          <p class="demo-note">The header noise and the TOTAL row were read as furniture and dropped. The space-grouped numbers and decimal commas were parsed, the three date formats reconciled. The missing amount was <b>flagged for review, not guessed</b>.</p>
        </section>

        <section id="who">
          <p class="sec-no">02 — Who it's for</p>
          <div class="who">
            <div>
              <h2>If someone else's file decides how your week goes.</h2>
              <p style="margin-top:1.4rem">It shows up in more places than you'd expect. A founder whose product runs on customer uploads. A recruiter reconciling candidate lists that arrive in a different shape from every client. An analyst whose month starts with the same spreadsheet and the same twenty minutes of cleanup.</p>
              <p>Different jobs, <strong>the same problem</strong>: the data is someone else's to format and yours to deal with. If that's a standing item in your week, Knyta is for you — whatever your title.</p>
              <p>Destinations are <strong>pluggable by design</strong>. Each one declares what it can do, and the engine delivers to it with the same transactional care. Postgres works today; APIs and other databases are on the way.</p>
            </div>
            <ul>
              <li class="y">the file arrives as an attachment</li>
              <li class="y">the format changes without warning</li>
              <li class="y">only you know what the columns mean</li>
              <li class="y">"the export" is the integration</li>
              <li class="n">book-a-demo walls</li>
              <li class="n">per-seat enterprise pricing</li>
              <li class="n">"just send it in our template"</li>
            </ul>
          </div>
        </section>

        <section id="how">
          <p class="sec-no">03 — How it works</p>
          <h2>AI writes the pipeline once. <em>Boring</em>, deterministic code runs it forever.</h2>
          <p class="sec-intro">Most "AI-powered" tools put a model in the hot path and hope. Knyta doesn't. AI does the one thing it's genuinely good at — reading a messy file nobody has seen before and writing the code to handle it. It does the same when a sender's format drifts, so <strong>the pipelines maintain themselves</strong>. Everything else is <strong>pinned, replayable and audited</strong>.</p>

          <ol class="steps">
            <li>
              <h3>A file lands on its channel</h3>
              <p>Every sender gets their own intake channel. Files arrive however they arrive, and you stop being the person who forwards attachments.</p>
            </li>
            <li>
              <h3>Known shape? It runs the pinned pipeline <span class="tag">no AI here</span></h3>
              <p>Each file's structure is fingerprinted. A match runs the exact pipeline approved for that shape, deterministically: <b>same file in, same rows out</b>. A guard also compares value shapes, so a file whose columns quietly swapped meaning under unchanged headers parks for a human instead of delivering mis-mapped data.</p>
            </li>
            <li>
              <h3>New or changed shape? An agent writes the pipeline <span class="tag">sandboxed</span></h3>
              <p>An AI agent reads the actual file, writes readable pipeline code with an explicit validation contract, and tests it against that file through the real execution path — inside a sandbox with <b>no credentials and no network</b>.</p>
            </li>
            <li>
              <h3>Nothing new touches production without approval <span class="tag">probation</span></h3>
              <p>A freshly written pipeline starts in probation: a human reviews its first output before anything reaches a live destination. Until then it runs against a dry-run client that is <b>structurally incapable of writing</b>.</p>
            </li>
            <li class="last">
              <h3>Delivery lands transactionally</h3>
              <p>Delivery runs as a saga: retried when it's provably safe, rolled back in reverse order when a step fails, and <b>quarantined with full context</b> when the outcome can't be known. A file that fails validation quarantines whole, never a half-imported mystery.</p>
            </li>
          </ol>
        </section>

        <section id="principles">
          <p class="sec-no">04 — Principles</p>
          <h2>Built the way you'd build it, if you had the month to spare.</h2>
          <p class="sec-intro">Data ingestion fails in quiet, expensive ways. Four rules hold up everything we build.</p>

          <div class="grid">
            <div class="principle">
              <span class="num">§1</span>
              <h3>Code, not a black box</h3>
              <p>Every pipeline is plain, readable code with an explicit validation contract. You can open it, diff it, and see exactly what happens to every column. No logic hidden behind an API you can't inspect.</p>
            </div>
            <div class="principle">
              <span class="num">§2</span>
              <h3>Boring on purpose</h3>
              <p>AI writes a pipeline once; after that the run path is deterministic. Re-running a file gives the same result every time. The clever part happens before approval, never during production runs.</p>
            </div>
            <div class="principle">
              <span class="num">§3</span>
              <h3>Trust is earned, not assumed</h3>
              <p>Autonomy is granted per decision type, lifted slowly after clean track records, and revoked the instant something faults. The riskiest actions keep a human in the loop for good. Every gate decision lands in an append-only audit log.</p>
            </div>
            <div class="principle">
              <span class="num">§4</span>
              <h3>Honest failure beats silent success</h3>
              <p>A value that doesn't validate is flagged, not guessed. A delivery whose outcome is unknown is quarantined, not reported clean. You won't find an import problem three weeks later, downstream, in something that mattered.</p>
            </div>
          </div>
        </section>

        <section id="contact" class="contact">
          <p class="sec-no">05 — Contact</p>
          <h2>Tell us about your <em>worst</em> file.</h2>
          <p>We work hands-on with a handful of early users right now. Send the ugliest file you deal with, and we'll tell you straight whether we can tie it down. You get an answer within two working days.</p>
          <p class="fineprint">Your file stays between us. We use it to answer your question and nothing else, we never pass it on, and we delete it whenever you ask. If an NDA makes this easier, say so and we'll sign one first.</p>
          <a class="email" href="mailto:hello@knyta.net?subject=Our%20worst%20file">hello@knyta.net</a>
        </section>

